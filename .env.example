# Copy these into Vercel: Project → Settings → Environment Variables.
# For running on your own computer, put them in .env.local (git ignores it).

# Supabase → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The "service_role" secret key. Server only. Never put it in the browser or in git.
SUPABASE_SERVICE_ROLE_KEY=

# Make these once with: npm run vapid
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Who the phone makers can contact about these notifications
VAPID_SUBJECT=https://clocked.kanishv.in

# Any long random string. Supabase's nightly timer sends it so only it can trigger the 8:30 pm message.
CRON_SECRET=

# Any long random string. Open /results?key=THIS to see the test results.
RESULTS_KEY=
